# ---------- Required ----------
# Long random string used to sign login sessions (e.g. `openssl rand -hex 32`). Mandatory in production.
SESSION_SECRET=
# Super Admin accounts (comma separated emails). The FIRST account registered on a fresh site is also made Super Admin.
# SECURITY: registration has no email verification, so register your admin account right after deploying,
# or leave this empty and use `node scripts/make-admin.mjs you@example.com` instead.
ADMIN_EMAILS=

# ---------- AI photo analysis (set at least one key; without any, the app runs in demo mode) ----------
# Which provider to use when several keys are set: gemini | openai | anthropic  (default: first key found, in that order)
AI_PROVIDER=
# Google Gemini: has a free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenAI (paid). Also works with any OpenAI-compatible endpoint via OPENAI_BASE_URL (e.g. OpenRouter, Groq)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic Claude. If set, it ALSO enables live market research + "5-10% below market" pricing (needs web search enabled in the Console)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
MARKET_RESEARCH=on
PRICE_DISCOUNT_PCT=7.5

# Rate-limit protection for batches: parallel AI calls and minimum ms between call starts.
# Gemini free tier defaults to 1 call every 4000 ms (~15/min). Raise/lower to match your plan.
AI_CONCURRENCY=2
AI_MIN_GAP_MS=

# ---------- Background removal (product cut out on pure white #FFFFFF) ----------
# local    = runs on your server with @imgly/background-removal-node (free, slower, needs RAM)  [default]
# removebg = remove.bg API (set REMOVEBG_API_KEY)
# none     = keep the original photo
BG_PROVIDER=local
REMOVEBG_API_KEY=

# ---------- Store ----------
NEXT_PUBLIC_STORE_NAME=SnapShop
NEXT_PUBLIC_CURRENCY=EUR
SHIPPING_FLAT=5
SITE_URL=http://localhost:3000
MAX_LISTINGS_PER_USER=500

# ---------- Payments (optional). Without it, orders are "pay on delivery" ----------
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). Create an endpoint https://YOUR-SITE/api/stripe/webhook in Stripe listening to
# checkout.session.completed and checkout.session.async_payment_succeeded. REQUIRED when STRIPE_SECRET_KEY is set.
STRIPE_WEBHOOK_SECRET=

# ---------- Cloud image storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2, MinIO, DigitalOcean Spaces) ----------
# When S3_BUCKET + keys are set, every processed photo is uploaded to the bucket and the PUBLIC CDN URL is stored in the DB.
# Without them, photos are saved on local disk (fine for development only).
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com   AWS: leave empty
S3_ENDPOINT=
S3_REGION=auto          # R2: auto   AWS: e.g. eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# public CDN base, e.g. https://cdn.example.com (R2 custom domain / r2.dev URL, or CloudFront)
S3_PUBLIC_URL=
# set to 1 for MinIO and some providers
S3_FORCE_PATH_STYLE=

# ---------- Paid ads (price per AD_DAYS days, in NEXT_PUBLIC_CURRENCY) ----------
AD_DAYS=30
AD_PRICE_BOOST=15
AD_PRICE_CATEGORY=20
AD_PRICE_BANNER_CATEGORY=30
AD_PRICE_BANNER_HOME=60
FEATURED_SLOTS_PER_CATEGORY=8

# ---------- Group buying / escrow ----------
# Platform commission (%) kept when funds are released to a warehouse (can be overridden per warehouse).
GROUP_FEE_PCT=0

# ---------- Email notifications for seller inquiries (optional; needs `nodemailer`, installed by default) ----------
# Without SMTP, inquiries still arrive in the seller's dashboard inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SnapShop <no-reply@example.com>"

# ---------- Storage (db.json + photos). Use a persistent volume in production ----------
DATA_DIR=./data
